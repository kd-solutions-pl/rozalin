@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 NXP
+ * Copyright 2026 kd-solutions.pl
+ */
+
+#include <env.h>
+#include <env_internal.h>
+#include <init.h>
+#include <command.h>
+#include <asm/arch/ccm_regs.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/gpio.h>
+#include <asm/arch/imx-regs.h>
+#include <asm/arch/imx91_pins.h>
+#include <asm/arch/sys_proto.h>
+#include <asm/gpio.h>
+#include <asm/io.h>
+#include <asm/mach-imx/iomux-v3.h>
+#include <asm/mach-imx/boot_mode.h>
+#include <i2c.h>
+#include <dm.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+
+#define TCPC_ALERT 0x10
+#define TCPC_ALERT_MASK 0x12
+#define TCPC_FAULT_STATUS_MASK 0x15
+#define USB_I2C_BUS 1
+#define USB_I2C_ADDR 0x52
+
+#define UART_PAD_CTRL		(PAD_CTL_DSE(6) | PAD_CTL_FSEL2)
+#define LCDIF_GPIO_PAD_CTRL	(PAD_CTL_DSE(0xf) | PAD_CTL_FSEL2 | PAD_CTL_PUE)
+
+static const iomux_v3_cfg_t uart_pads[] = {
+	MX91_PAD_UART1_RXD__LPUART1_RX | MUX_PAD_CTRL(UART_PAD_CTRL),
+	MX91_PAD_UART1_TXD__LPUART1_TX | MUX_PAD_CTRL(UART_PAD_CTRL),
+};
+
+static const iomux_v3_cfg_t lcdif_gpio_pads[] = {
+	MX91_PAD_GPIO_IO00__GPIO2_IO0 | MUX_PAD_CTRL(LCDIF_GPIO_PAD_CTRL),
+	MX91_PAD_GPIO_IO01__GPIO2_IO1 | MUX_PAD_CTRL(LCDIF_GPIO_PAD_CTRL),
+	MX91_PAD_GPIO_IO02__GPIO2_IO2 | MUX_PAD_CTRL(LCDIF_GPIO_PAD_CTRL),
+	MX91_PAD_GPIO_IO03__GPIO2_IO3 | MUX_PAD_CTRL(LCDIF_GPIO_PAD_CTRL),
+};
+
+int board_early_init_f(void)
+{
+	struct gpio_regs *gpio2 = (struct gpio_regs *)(GPIO2_BASE_ADDR + 0x40);
+
+	imx_iomux_v3_setup_multiple_pads(uart_pads, ARRAY_SIZE(uart_pads));
+	imx_iomux_v3_setup_multiple_pads(lcdif_gpio_pads, ARRAY_SIZE(lcdif_gpio_pads));
+
+	/* Keep LCD signals low and backlight disabled before display init. */
+	setbits_le32(&gpio2->gpio_pcor, 0xf);
+	setbits_le32(&gpio2->gpio_pddr, 0xf);
+	setbits_le32(&gpio2->gpio_psor, BIT(26));
+	setbits_le32(&gpio2->gpio_pddr, BIT(26));
+
+	init_uart_clk(LPUART1_CLK_ROOT);
+
+	return 0;
+}
+
+/*
+ * Since tcpc driver is not upstream. PTN5110 interrupt will cause
+ * kernel panic because nobody cares the interrupt. So add workaround here.
+ * Clear PTN5110 USB Power Delivery controller alert status by
+ * masking interrupts and clearing pending alerts via I2C communication.
+ * This is typically called during board initialization to ensure the USB PD
+ * controller starts in a clean state without any stale alert conditions.
+ */
+static int clear_pd_alert(void)
+{
+	struct udevice *bus;
+	struct udevice *i2c_dev = NULL;
+	int ret;
+	u8 buffer_0[2] = {0, 0};
+	u8 buffer_1[2] = {0xff, 0xff};
+
+	ret = uclass_get_device_by_seq(UCLASS_I2C, USB_I2C_BUS, &bus);
+	if (ret) {
+		printf("Failed to get I2C bus %d\n", USB_I2C_BUS);
+		return ret;
+	}
+
+	ret = dm_i2c_probe(bus, USB_I2C_ADDR, 0, &i2c_dev);
+	if (ret) {
+		printf("Can't find USB PD device at 0x%02x\n", USB_I2C_ADDR);
+		return ret;
+	}
+
+	/* Mask all alert status */
+	ret = dm_i2c_write(i2c_dev, TCPC_ALERT_MASK, buffer_0, 2);
+	if (ret) {
+		printf("%s dm_i2c_write failed: %d\n", __func__, ret);
+		return ret;
+	}
+
+	ret = dm_i2c_write(i2c_dev, TCPC_FAULT_STATUS_MASK, buffer_0, 2);
+	if (ret) {
+		printf("%s dm_i2c_write failed: %d\n", __func__, ret);
+		return ret;
+	}
+
+	ret = dm_i2c_write(i2c_dev, TCPC_ALERT, buffer_1, 2);
+	if (ret) {
+		printf("%s dm_i2c_write failed: %d\n", __func__, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void board_gpio_init(void)
+{
+	struct gpio_desc desc;
+	int ret;
+
+	/* Reset ENET_QOS PHY */
+	ret = dm_gpio_lookup_name("GPIO3_17", &desc);
+	if (ret)
+		return;
+
+	ret = dm_gpio_request(&desc, "eth0_rst");
+	if (ret)
+		return;
+
+	dm_gpio_set_dir_flags(&desc, GPIOD_IS_OUT);
+	dm_gpio_set_value(&desc, 1);
+	udelay(10000);
+	dm_gpio_set_value(&desc, 0);
+
+	/* Enable EXT1_PWREN on the expansion header */
+	ret = dm_gpio_lookup_name("gpio@22_13", &desc);
+	if (ret)
+		return;
+
+	ret = dm_gpio_request(&desc, "EXT1_PWREN");
+	if (ret)
+		return;
+
+	dm_gpio_set_dir_flags(&desc, GPIOD_IS_OUT);
+	dm_gpio_set_value(&desc, 1);
+
+	/* Deassert SD3_nRST */
+	ret = dm_gpio_lookup_name("gpio@22_12", &desc);
+	if (ret)
+		return;
+
+	ret = dm_gpio_request(&desc, "SD3_nRST");
+	if (ret)
+		return;
+
+	dm_gpio_set_dir_flags(&desc, GPIOD_IS_OUT);
+	dm_gpio_set_value(&desc, 1);
+
+	/* Enable EXT_PWREN for vEXP 5V */
+	ret = dm_gpio_lookup_name("gpio@22_8", &desc);
+	if (ret)
+		return;
+
+	ret = dm_gpio_request(&desc, "EXT_PWREN");
+	if (ret)
+		return;
+
+	dm_gpio_set_dir_flags(&desc, GPIOD_IS_OUT);
+	dm_gpio_set_value(&desc, 1);
+}
+
+enum env_location env_get_location(enum env_operation op, int prio)
+{
+	if (prio)
+		return ENVL_UNKNOWN;
+	if (CONFIG_IS_ENABLED(IMX9_NAND_2K_BOOT) &&
+	    CONFIG_IS_ENABLED(ENV_IS_IN_UBI)) {
+	  return ENVL_UBI;
+	}
+	return ENVL_NOWHERE;
+}
+
+static void board_late_ubi_env_init(void)
+{
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_ENV_IS_IN_UBI))
+		return;
+
+	ret = run_command("run init_ubi_env", 0);
+	if (ret)
+		printf("Failed to initialize UBI environment: %d\n", ret);
+}
+
+int board_init(void)
+{
+	board_gpio_init();
+
+	return 0;
+}
+
+int board_late_init(void)
+{
+	if (IS_ENABLED(CONFIG_USB_FUNCTION_FASTBOOT) &&
+	    get_boot_device() == USB_BOOT)
+		env_set("bootcmd", "run bootcmd_mfg");
+
+	env_set("sec_boot", "no");
+
+	if (IS_ENABLED(CONFIG_AHAB_BOOT))
+		env_set("sec_boot", "yes");
+
+	if (IS_ENABLED(CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG)) {
+		env_set("board_name", "11X11_FRDM");
+		env_set("board_rev", "iMX91");
+	}
+
+	board_late_ubi_env_init();
+
+	clear_pd_alert();
+	return 0;
+}
diff --git a/board/nxp/imx91s_frdm/imx91s_frdm.env b/board/nxp/imx91s_frdm/imx91s_frdm.env
new file mode 100644
index 00000000000..0a481e31afa
--- /dev/null
+++ b/board/nxp/imx91s_frdm/imx91s_frdm.env
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: (GPL-2.0+ OR MIT) */
+
+bootcmd_mfg=echo Running fastboot mode; fastboot usb 0
+bootm_size=0x10000000
+console=ttyLP0,115200 earlycon
+fdt_addr_r=0x83000000
+fdt_addr=0x83000000
+fdtfile=DEFAULT_FDT_FILE
+image=Image
+env_addr=0x83400000
+env_mtd=env
+env_size=CONFIG_ENV_SIZE
+env_ubi_volume=uboot-env
+init_ubi_env=
+	if ubi part ${env_mtd}; then
+		echo UBI environment partition is ready;
+	else
+		echo Initializing UBI environment partition;
+		mtd erase ${env_mtd};
+		ubi part ${env_mtd};
+	fi;
+	if ubi check ${env_ubi_volume}; then
+		echo U-Boot environment volume already exists;
+	else
+		ubi create ${env_ubi_volume} ${env_size} dynamic;
+		env export -c -s ${env_size} ${env_addr};
+		ubi write ${env_addr} ${env_ubi_volume} ${env_size};
+	fi;
+nand_kernel_size=0x2800000
+nand_dtb_size=0x20000
+nandargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console}
+	ubi.mtd=rootfs root=ubi0:rootfs rootfstype=ubifs rootwait rw
+	${mtdparts}
+loadimage_nand=mtd read kernel ${loadaddr} 0 ${nand_kernel_size}
+loadfdt_nand=mtd read dtb ${fdt_addr_r} 0 ${nand_dtb_size}
+nandboot=
+	echo Booting from NAND ...;
+	run init_ubi_env;
+	run nandargs;
+	if run loadimage_nand; then
+		if run loadfdt_nand; then
+			run boot_os;
+		else
+			echo WARN: Cannot load the DT from NAND;
+		fi;
+	fi;
+boot_os=booti ${loadaddr} - ${fdt_addr_r}
