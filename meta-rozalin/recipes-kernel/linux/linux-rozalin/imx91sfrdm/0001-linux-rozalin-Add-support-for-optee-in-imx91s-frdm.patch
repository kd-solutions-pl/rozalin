From 37e77a60b5b9e5ef82728e5fadef47e1a94717f2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Krzysztof=20Drobi=C5=84ski?= <krzysztof@kd-solutions.pl>
Date: Tue, 23 Jun 2026 17:26:01 +0200
Subject: [PATCH] linux-rozalin: Add support for optee in imx91s frdm
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream-Status: Pending

Signed-off-by: Krzysztof Drobiński <krzysztof@kd-solutions.pl>
---
 arch/arm64/boot/dts/freescale/imx91-11x11-frdm-s.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx91-11x11-frdm-s.dts b/arch/arm64/boot/dts/freescale/imx91-11x11-frdm-s.dts
index 62dc1dedfb0e..46a67882741d 100644
--- a/arch/arm64/boot/dts/freescale/imx91-11x11-frdm-s.dts
+++ b/arch/arm64/boot/dts/freescale/imx91-11x11-frdm-s.dts
@@ -32,6 +32,13 @@ chosen {
 		stdout-path = &lpuart1;
 	};
 
+	firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+	};
+
 	flexcan1_phy: can-phy {
 		compatible = "nxp,tja1051";
 		#phy-cells = <0>;
-- 
2.53.0

